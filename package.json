{
  "name": "create-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @create-world/server --filter @create-world/web dev",
    "dev:server": "pnpm --filter @create-world/server dev",
    "dev:web": "pnpm --filter @create-world/web dev",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @create-world/web build && pnpm --filter @create-world/server deploy",
    "typecheck": "pnpm -r typecheck"
  }
}
