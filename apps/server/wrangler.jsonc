{
  "name": "create-world",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-world-db-apac",
      "database_id": "ab944cf3-4796-4769-854b-103cb10f55a8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "2e4fca38f4af4b019c3a6334c1236c27"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    // 只让 /api/* 交 Worker；
    // 首页 HTML 保持静态直出——曾尝试让 Worker 接管 `/` 以便加缓存头，
    // 但 assets 返回的 HTML 响应会重定向到 `/`，两者叠加形成 307 死循环（实测），
    // 因此首页缓存头改用 `_headers` 声明（对 HTML 不生效，属已知限制，不再用 Worker 绕）。
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  }
}
