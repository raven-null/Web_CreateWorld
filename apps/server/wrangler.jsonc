{
  "name": "create-world",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-world-db",
      "database_id": "93086a82-28e0-4559-bd2e-f49d8eaeac7c",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "2e4fca38f4af4b019c3a6334c1236c27"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
