{
  "name": "create-world",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "create-world-db-apac",
      "database_id": "ab944cf3-4796-4769-854b-103cb10f55a8",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "IMAGES",
      "id": "2e4fca38f4af4b019c3a6334c1236c27"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    // SPA 回退：前端路由需要它。
    // ⚠️ 注意：回退会把「未命中的请求」也返回 index.html（200），包括已失效的构建产物；
    // 曾尝试用 Worker 接管 /assets/* 来纠正，结果把**真实资源**也打成 404，已回滚。
    // 该风险的兜底改在前端：入口 chunk 加载失败时自动刷新一次（见 lib/api.ts）。
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS"
  }
}
